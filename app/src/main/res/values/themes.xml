<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Theme.Gate8POS" parent="android:Theme.Material.Light.NoActionBar">

        <item name="android:statusBarColor">@color/gate8_navigation_bar</item>

        <item name="android:navigationBarColor">@color/gate8_navigation_bar</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:enforceStatusBarContrast">false</item>

        <item name="android:enforceNavigationBarContrast">false</item>

    </style>



    <style name="Theme.Gate8POS.Splash" parent="android:Theme.Material.Light.NoActionBar">

        <item name="android:windowBackground">@drawable/splash_window_bg</item>

        <item name="android:statusBarColor">@color/gate8_navigation_bar</item>

        <item name="android:navigationBarColor">@color/gate8_navigation_bar</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:enforceStatusBarContrast">false</item>

        <item name="android:enforceNavigationBarContrast">false</item>

    </style>

</resources>

